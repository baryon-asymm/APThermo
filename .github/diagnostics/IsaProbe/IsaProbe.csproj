<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A tree node (BOOT.md and API.md beside this file); the directory is read by the protocol linter as part of the
    tree, `.github` being the one dot directory it reads (tools/protocol-lint/protocol_lint.py's
    `DOT_DIRECTORIES_READ`). It never enters APThermo.sln and no node depends on it; run directly with
    "dotnet run", its project argument pointed at this directory.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
