<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not a tree node: .github holds CI configuration only, and the protocol linter and Protocol.Tests both skip
    dot-prefixed directories (root BOOT.md's "Continuous integration"; tools/protocol-lint/protocol_lint.py's
    `_excluded`; tests/Protocol.Tests/Tree.cs's `Skipped`, which never even lists .github since Tree.Walk only turns
    a directory into a node when it already holds BOOT.md and API.md). It never enters APThermo.sln and no node
    depends on it; run directly with "dotnet run", its project argument pointed at this directory.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
