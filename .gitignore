*.fields.txt

# BenchmarkDotNet's default output directory for an ad hoc run outside tests/Benchmarks/results/
BenchmarkDotNet.Artifacts/

# Python
__pycache__/

# Local tool state
.claude/settings.local.json
.venv/

# Agent worktrees of Claude Code sessions
.claude/worktrees/
