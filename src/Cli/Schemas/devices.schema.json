{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apthermo devices listing",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "cudaForbidden", "cpu", "cuda"],
  "properties": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "command"],
      "properties": {
        "tool": { "const": "apthermo" },
        "version": { "type": "string" },
        "command": { "const": "devices" }
      }
    },
    "cudaForbidden": { "type": "boolean" },
    "cpu": { "$ref": "#/$defs/accelerator" },
    "cuda": { "oneOf": [{ "$ref": "#/$defs/accelerator" }, { "$ref": "#/$defs/unavailable" }] }
  },
  "$defs": {
    "accelerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "deviceName", "ilgpuVersion", "threadsOrMultiprocessors", "cudaSkippedBecause"],
      "properties": {
        "kind": { "enum": ["cpu", "cuda"] },
        "deviceName": { "type": "string" },
        "ilgpuVersion": { "type": "string" },
        "threadsOrMultiprocessors": { "type": "integer" },
        "cudaSkippedBecause": { "type": ["string", "null"] }
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "message"],
      "properties": {
        "available": { "const": false },
        "message": { "type": "string" }
      }
    }
  }
}
