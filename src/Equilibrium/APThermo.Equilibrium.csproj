<Project Sdk="Microsoft.NET.Sdk">

  <!-- Node src/Equilibrium: the equilibrium composition of one case by Gibbs minimization (RP-1311 chapters 2 and 3). Kernel-compatible. -->

  <!-- The library assemblies ship their XML documentation (root BOOT.md, Delivery: Symbols); a public member
       without a documentation comment fails the build, since warnings are errors. Diagnostics (2026-09-24):
       GenerateDocumentationFile is now set once, for every project, in the root Directory.Build.props. -->

  <ItemGroup>
    <ProjectReference Include="..\Thermo\APThermo.Thermo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" />
  </ItemGroup>

  <!-- The tree contract of src/Equilibrium (root BOOT.md, Delivery: Tree contracts): the src nodes that
       declare Equilibrium in their ## Dependencies, and their mirroring test nodes. No kernel parameter or
       view element of this node is internal, so no ILGPURuntime grant is needed. -->
  <ItemGroup>
    <!-- The tests node checks the internal dense solver on small systems (its BOOT.md, level L0). -->
    <InternalsVisibleTo Include="APThermo.Equilibrium.Tests" />
    <InternalsVisibleTo Include="APThermo.Performance" />
    <InternalsVisibleTo Include="APThermo.Performance.Tests" />
    <InternalsVisibleTo Include="APThermo.Transport" />
    <!-- The tests node cross-checks the transport set's EquilibriumHeatCapacity against an independently solved
         state's CpEquilibrium (2026-09-28, the orchestrator's decision under AGENTS.md §11). -->
    <InternalsVisibleTo Include="APThermo.Transport.Tests" />
    <InternalsVisibleTo Include="APThermo.Execution" />
    <InternalsVisibleTo Include="APThermo.Execution.Tests" />
  </ItemGroup>

</Project>
