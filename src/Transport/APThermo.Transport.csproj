<Project Sdk="Microsoft.NET.Sdk">

  <!-- Node src/Transport: mixture viscosity, thermal conductivity and Prandtl number of one station (RP-1311 chapter 5). Kernel-compatible. -->

  <!-- The library assemblies ship their XML documentation (root BOOT.md, Delivery: Symbols); a public member
       without a documentation comment fails the build, since warnings are errors (Directory.Build.props). -->
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Data\APThermo.Data.csproj" />
    <ProjectReference Include="..\Thermo\APThermo.Thermo.csproj" />
    <ProjectReference Include="..\Equilibrium\APThermo.Equilibrium.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ILGPU" />
  </ItemGroup>

  <!-- The tree contract of src/Transport (root BOOT.md, Delivery: Tree contracts): the src nodes that
       declare Transport in their ## Dependencies, their mirroring test nodes plus Benchmarks and
       Problems.Tests, and ILGPURuntime for TransportTableView, a kernel parameter type
       (API.md, ## Transport tables (tree contract)). -->
  <ItemGroup>
    <InternalsVisibleTo Include="APThermo.Transport.Tests" />
    <InternalsVisibleTo Include="APThermo.Execution" />
    <InternalsVisibleTo Include="APThermo.Execution.Tests" />
    <InternalsVisibleTo Include="APThermo.Problems" />
    <InternalsVisibleTo Include="APThermo.Problems.Tests" />
    <InternalsVisibleTo Include="APThermo.Benchmarks" />
    <InternalsVisibleTo Include="ILGPURuntime" />
  </ItemGroup>

</Project>
