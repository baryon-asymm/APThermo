<Project>

  <!-- Shared build settings of every project in the tree (root BOOT.md, Constraints). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Diagnostics (root BOOT.md, Constraints, 2026-09-24): the compiler and every analyzer at maximum, for every project. -->
    <WarningLevel>9999</WarningLevel>
    <Features>strict</Features>
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- The one version of every package (root BOOT.md, ## Delivery, Packages): a release tag v<version> must equal it. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

  <!--
    The rest of the package metadata (authors, license, tags, symbols, NOTICE) lives in
    Directory.Build.targets, not here: it is conditioned on IsPackable, which a project sets in its own
    body, after this props file has already been imported (Directory.Build.targets explains why).
  -->

</Project>
