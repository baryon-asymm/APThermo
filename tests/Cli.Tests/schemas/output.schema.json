{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "apthermo result document (src/Cli/API.md, Output document)",
  "type": "object",
  "additionalProperties": false,
  "required": ["run", "cases"],
  "properties": {
    "run": { "$ref": "#/$defs/run" },
    "cases": { "type": "array", "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "status": { "enum": ["ok", "invalidInput", "notConverged", "singularMatrix", "temperatureOutOfRange", "throatNotFound", "areaRatioInvalid", "noTransportData"] },
    "number": { "type": ["number", "null"] },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version", "command", "inputs", "database", "accelerator", "timings", "threshold"],
      "properties": {
        "tool": { "const": "apthermo" },
        "version": { "type": "string" },
        "command": { "enum": ["rocket", "equilibrium", "states"] },
        "inputs": { "type": "array", "items": { "type": "string" } },
        "database": { "$ref": "#/$defs/database" },
        "accelerator": { "$ref": "#/$defs/accelerator" },
        "timings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database", "solve"],
          "properties": { "database": { "type": "number", "minimum": 0 }, "solve": { "type": "number", "minimum": 0 } }
        },
        "threshold": { "type": "number", "minimum": 0 }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thermoPath", "transPath", "thermoSha256", "transSha256"],
      "properties": {
        "thermoPath": { "type": "string" },
        "transPath": { "type": ["string", "null"] },
        "thermoSha256": { "type": "string" },
        "transSha256": { "type": ["string", "null"] }
      }
    },
    "accelerator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "deviceName", "ilgpuVersion", "libNvvmPath", "libDevicePath", "threadsOrMultiprocessors"],
      "properties": {
        "kind": { "enum": ["cpu", "cuda"] },
        "deviceName": { "type": "string" },
        "ilgpuVersion": { "type": "string" },
        "libNvvmPath": { "type": ["string", "null"] },
        "libDevicePath": { "type": ["string", "null"] },
        "threadsOrMultiprocessors": { "type": "integer" }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "inputs", "status", "mixture", "stations"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "inputs": { "type": "object" },
        "status": { "$ref": "#/$defs/status" },
        "mixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["elementMoles", "enthalpy"],
          "properties": {
            "elementMoles": { "type": "object", "additionalProperties": { "type": "number" } },
            "enthalpy": { "type": ["number", "null"] }
          }
        },
        "stations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/station" } }
      }
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "status",
        "temperature", "pressure", "density", "enthalpy", "internalEnergy", "entropy", "gibbsEnergy", "molarMass", "mixtureMolarMass",
        "cpFrozen", "cpEquilibrium", "cvFrozen", "cvEquilibrium", "dlnVdlnT", "dlnVdlnP", "gammaS", "soundSpeed", "velocity", "mach",
        "moleFractions", "condensedMassFractions"
      ],
      "properties": {
        "name": { "type": "string" },
        "status": { "$ref": "#/$defs/status" },
        "temperature": { "$ref": "#/$defs/number" },
        "pressure": { "$ref": "#/$defs/number" },
        "density": { "$ref": "#/$defs/number" },
        "enthalpy": { "$ref": "#/$defs/number" },
        "internalEnergy": { "$ref": "#/$defs/number" },
        "entropy": { "$ref": "#/$defs/number" },
        "gibbsEnergy": { "$ref": "#/$defs/number" },
        "molarMass": { "$ref": "#/$defs/number" },
        "mixtureMolarMass": { "$ref": "#/$defs/number" },
        "cpFrozen": { "$ref": "#/$defs/number" },
        "cpEquilibrium": { "$ref": "#/$defs/number" },
        "cvFrozen": { "$ref": "#/$defs/number" },
        "cvEquilibrium": { "$ref": "#/$defs/number" },
        "dlnVdlnT": { "$ref": "#/$defs/number" },
        "dlnVdlnP": { "$ref": "#/$defs/number" },
        "gammaS": { "$ref": "#/$defs/number" },
        "soundSpeed": { "$ref": "#/$defs/number" },
        "velocity": { "$ref": "#/$defs/number" },
        "mach": { "$ref": "#/$defs/number" },
        "performance": { "$ref": "#/$defs/performance" },
        "moleFractions": { "type": "object", "additionalProperties": { "type": "number" } },
        "condensedMassFractions": { "type": "object", "additionalProperties": { "type": "number" } },
        "transport": { "$ref": "#/$defs/transport" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "areaRatio", "pressureRatio", "characteristicVelocity", "thrustCoefficient", "specificImpulse", "vacuumSpecificImpulse",
        "specificImpulseSeconds", "vacuumSpecificImpulseSeconds"
      ],
      "properties": {
        "areaRatio": { "$ref": "#/$defs/number" },
        "pressureRatio": { "$ref": "#/$defs/number" },
        "characteristicVelocity": { "$ref": "#/$defs/number" },
        "thrustCoefficient": { "$ref": "#/$defs/number" },
        "specificImpulse": { "$ref": "#/$defs/number" },
        "vacuumSpecificImpulse": { "$ref": "#/$defs/number" },
        "specificImpulseSeconds": { "$ref": "#/$defs/number" },
        "vacuumSpecificImpulseSeconds": { "$ref": "#/$defs/number" }
      }
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "viscosity": { "$ref": "#/$defs/number" },
        "frozenConductivity": { "$ref": "#/$defs/number" },
        "reactingConductivity": { "$ref": "#/$defs/number" },
        "frozenPrandtl": { "$ref": "#/$defs/number" },
        "reactingPrandtl": { "$ref": "#/$defs/number" },
        "frozenHeatCapacity": { "$ref": "#/$defs/number" },
        "equilibriumHeatCapacity": { "$ref": "#/$defs/number" },
        "estimatedMoleFraction": { "$ref": "#/$defs/number" },
        "speciesCount": { "type": "integer" },
        "reactionCount": { "type": "integer" },
        "estimatedSpeciesCount": { "type": "integer" },
        "traceEliminations": { "type": "integer" },
        "capped": { "type": "integer" }
      }
    }
  }
}
