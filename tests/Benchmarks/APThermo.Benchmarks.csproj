<Project Sdk="Microsoft.NET.Sdk">

  <!-- Node tests/Benchmarks: a library of BenchmarkDotNet benchmark classes measuring how fast the library computes.
       Run by hand through its child node Runner (see tests/Benchmarks/Runner/APThermo.Benchmarks.Runner.csproj),
       never by dotnet test: it carries no test SDK. A class library since 2026-09-25 (BOOT.md): the root's
       Diagnostics constraint (CA1515) forbids public types in an executable, and BenchmarkDotNet requires public
       benchmark classes, so the entry point moved to the child node Runner. -->
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Data\APThermo.Data.csproj" />
    <ProjectReference Include="..\..\src\Thermo\APThermo.Thermo.csproj" />
    <ProjectReference Include="..\..\src\Equilibrium\APThermo.Equilibrium.csproj" />
    <ProjectReference Include="..\..\src\Performance\APThermo.Performance.csproj" />
    <ProjectReference Include="..\..\src\Execution\APThermo.Execution.csproj" />
    <ProjectReference Include="..\..\src\Problems\APThermo.Problems.csproj" />
    <ProjectReference Include="..\Fixtures\APThermo.Fixtures.csproj" />
    <ProjectReference Include="..\Harness\APThermo.Harness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ILGPU" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\user-states.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The child node Runner is its own project, nested in the Runner subdirectory (BOOT.md). The SDK's default
       globs only exclude this project's own bin/obj, not a nested project's, so its files (and its generated
       obj/AssemblyInfo, once it has built) must be excluded here or they compile twice: once as this project's
       own item, once as Runner's. -->
  <ItemGroup>
    <Compile Remove="Runner\**" />
    <None Remove="Runner\**" />
    <EmbeddedResource Remove="Runner\**" />
  </ItemGroup>

</Project>
