<Project Sdk="Microsoft.NET.Sdk">

  <!-- Node tests/Benchmarks: measures how fast the library computes, with BenchmarkDotNet.
       Run by hand (dotnet run -c Release), never by dotnet test: it carries no test SDK. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>false</IsTestProject>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Data\APThermo.Data.csproj" />
    <ProjectReference Include="..\..\src\Thermo\APThermo.Thermo.csproj" />
    <ProjectReference Include="..\..\src\Equilibrium\APThermo.Equilibrium.csproj" />
    <ProjectReference Include="..\..\src\Performance\APThermo.Performance.csproj" />
    <ProjectReference Include="..\..\src\Execution\APThermo.Execution.csproj" />
    <ProjectReference Include="..\..\src\Problems\APThermo.Problems.csproj" />
    <ProjectReference Include="..\Fixtures\APThermo.Fixtures.csproj" />
    <ProjectReference Include="..\Harness\APThermo.Harness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="ILGPU" />
  </ItemGroup>

  <ItemGroup>
    <None Include="data\user-states.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
