<Project>

  <!--
    Package metadata and symbols (root BOOT.md, ## Delivery), applied only to the packable projects
    (src/Problems, src/Cli). This lives in a .targets file, not in Directory.Build.props: props files
    import before a project's own body, so a condition on IsPackable there would still see the SDK's
    default (false) — a project sets IsPackable in its own body, which only a .targets file (imported
    after that body) can react to.
  -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <Authors>Eduard Burachek</Authors>
    <PackageLicenseExpression>MIT AND Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>rocket-propulsion;combustion;thermodynamics;chemical-equilibrium;nasa-cea;ilgpu;cuda</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <!--
    ContinuousIntegrationBuild is set by the workflows on their `dotnet pack` command lines only (root
    BOOT.md, ## Delivery, Symbols; CI/CD and build audit, F2), never here: a condition on GITHUB_ACTIONS
    would apply only to the project MSBuild was invoked on directly, not to the six referenced projects
    that `dotnet pack src/Problems` merges into the package (none of them is IsPackable), so six of the
    seven merged PDBs stayed non-deterministic. A global property passed on the pack command line instead
    flows to the whole build graph, referenced projects included, and it must stay off during `dotnet
    build`/`dotnet test`: `tests/Fixtures/RepositoryPaths.cs`, `tests/Protocol.Tests/Tree.cs` and
    `tests/Execution.Tests/CudaTests.cs` locate the tree root from `[CallerFilePath]`, which
    ContinuousIntegrationBuild's deterministic source paths would break.
  -->

  <!-- data/NOTICE (Apache-2.0, the NASA data) packed at the root of every package. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)data\NOTICE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
